<!DOCTYPE CrossStudio_Project_File>
<solution Name="firmware_clight" version="2" target="8">
  <configuration
    Name="Debug"
    c_preprocessor_definitions="DEBUG"
    gcc_debugging_level="Level 3"
    gcc_omit_frame_pointer="Yes"
    gcc_optimization_level="None" />
  <configuration
    Name="Release"
    c_preprocessor_definitions="NDEBUG"
    gcc_debugging_level="Level 2"
    gcc_omit_frame_pointer="Yes"
    gcc_optimization_level="Level 2 balanced" />
  <project Name="firmware_clight">
    <configuration
      LIBRARY_IO_TYPE="RTT"
      Name="Common"
      Target="STM32F103C6"
      arm_architecture="v7M"
      arm_compiler_variant="SEGGER"
      arm_core_type="Cortex-M3"
      arm_endian="Little"
      arm_fp_abi="Soft"
      arm_fpu_type="None"
      arm_linker_heap_size="1024"
      arm_linker_process_stack_size="0"
      arm_linker_stack_size="2048"
      arm_linker_variant="GNU"
      arm_simulator_memory_simulation_parameter="ROM;0x08000000;0x00008000;RAM;0x20000000;0x00002800"
      arm_target_device_name="STM32F103C6"
      arm_target_interface_type="SWD"
      c_preprocessor_definitions="ARM_MATH_CM3;__STM32F103_SUBFAMILY;__STM32F1XX_FAMILY;__NO_FPU_ENABLE;STM32F103x6;USE_HAL_DRIVER"
      c_user_include_directories="$(ProjectDir)/../source/drivers/CMSIS/Include;$(ProjectDir)/../source/drivers/CMSIS/Device/ST/STM32F1xx/Include;$(ProjectDir)/../source/users/core;$(ProjectDir)/../source/users/leds;$(ProjectDir)/../source/users/play;$(ProjectDir)/../source/users/regulator;$(ProjectDir)/../source/users/signal_extern;$(ProjectDir)/../source/users/switch;$(ProjectDir)/../source/drivers/STM32F1xx_HAL_Driver/Inc;$(ProjectDir)/../source/drivers/STM32F1xx_HAL_Driver/Inc/Legacy"
      debug_register_definition_file="$(ProjectDir)/STM32F103xx_Registers.xml"
      debug_stack_pointer_start="__stack_end__"
      debug_start_from_entry_point_symbol="Yes"
      debug_target_connection="J-Link"
      gcc_entry_point="Reset_Handler"
      link_linker_script_file="$(ProjectDir)/../source/drivers/CMSIS/Device/ST/STM32F1xx/Source/Templates/gcc/linker/STM32F103X6_FLASH.ld"
      link_use_linker_script_file="Yes"
      linker_memory_map_file="$(ProjectDir)/STM32F103C6_MemoryMap.xml"
      macros="DeviceHeaderFile=$(PackagesDir)/STM32F1xx/Device/Include/stm32f10x.h;DeviceSystemFile=$(PackagesDir)/STM32F1xx/Device/Source/system_stm32f10x.c;DeviceVectorsFile=$(PackagesDir)/STM32F1xx/Source/stm32f10x_ld_Vectors.s;DeviceFamily=STM32F1xx;DeviceSubFamily=STM32F103;Target=STM32F103C6"
      project_directory=""
      project_type="Executable"
      target_reset_script="Reset();" />
    <configuration
      Name="Debug"
      arm_compiler_variant="gcc"
      arm_linker_variant="GNU"
      c_user_include_directories=""
      gcc_c_language_standard="c11"
      linker_memory_map_file="$(ProjectDir)/STM32F103C6_MemoryMap.xml" />
    <folder Name="CMSIS Files">
      <file file_name="../source/drivers/CMSIS/Device/ST/STM32F1xx/Include/stm32f103x6.h" />
      <file file_name="../source/drivers/CMSIS/Device/ST/STM32F1xx/Source/Templates/system_stm32f1xx.c" />
    </folder>
    <folder Name="Script Files">
      <file file_name="STM32F1xx/Scripts/STM32F1xx_Target.js">
        <configuration Name="Common" file_type="Reset Script" />
      </file>
    </folder>
    <folder Name="Source Files">
      <configuration Name="Common" filter="c;cpp;cxx;cc;h;s;asm;inc" />
      <folder Name="core">
        <file file_name="../source/users/core/main.c" />
      </folder>
      <folder Name="HAL">
        <file file_name="../source/drivers/STM32F1xx_HAL_Driver/Src/stm32f1xx_hal.c" />
        <file file_name="../source/drivers/STM32F1xx_HAL_Driver/Src/stm32f1xx_hal_adc.c" />
        <file file_name="../source/drivers/STM32F1xx_HAL_Driver/Src/stm32f1xx_hal_adc_ex.c" />
        <file file_name="../source/drivers/STM32F1xx_HAL_Driver/Src/stm32f1xx_hal_cortex.c" />
        <file file_name="../source/drivers/STM32F1xx_HAL_Driver/Src/stm32f1xx_hal_dma.c" />
        <file file_name="../source/drivers/STM32F1xx_HAL_Driver/Src/stm32f1xx_hal_gpio.c" />
        <file file_name="../source/drivers/STM32F1xx_HAL_Driver/Src/stm32f1xx_hal_gpio_ex.c" />
        <file file_name="../source/drivers/STM32F1xx_HAL_Driver/Src/stm32f1xx_hal_rcc.c" />
        <file file_name="../source/drivers/STM32F1xx_HAL_Driver/Src/stm32f1xx_hal_rcc_ex.c" />
        <file file_name="../source/drivers/STM32F1xx_HAL_Driver/Src/stm32f1xx_hal_tim.c" />
        <file file_name="../source/drivers/STM32F1xx_HAL_Driver/Src/stm32f1xx_hal_tim_ex.c" />
      </folder>
      <folder Name="leds">
        <file file_name="../source/users/leds/led_driver.c" />
        <file file_name="../source/users/leds/led_pattern.c" />
      </folder>
      <folder Name="play">
        <file file_name="../source/users/play/blink.c" />
        <file file_name="../source/users/play/blink_break.c" />
        <file file_name="../source/users/play/blink_turn.c" />
      </folder>
      <folder Name="regulator">
        <file file_name="../source/users/regulator/adc-driver.c" />
      </folder>
      <folder Name="signals">
        <file file_name="../source/users/signal_extern/signal_extern.c" />
      </folder>
      <folder Name="switch">
        <file file_name="../source/users/switch/switch.c" />
      </folder>
    </folder>
    <folder Name="System Files">
      <file file_name="../source/drivers/CMSIS/Device/ST/STM32F1xx/Source/Templates/gcc/startup_stm32f103x6.s" />
    </folder>
  </project>
</solution>
